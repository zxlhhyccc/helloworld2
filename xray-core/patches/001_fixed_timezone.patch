@@ -3,12 +3,101 @@
 import (
 	"flag"
 	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
 
 	"github.com/xtls/xray-core/main/commands/base"
 	_ "github.com/xtls/xray-core/main/distro/all"
 )
 
+func fixedTimeZone() {
+	// 解决 openwrt 时区问题
+	// zonezoneinfo 包
+	_, timeZoneErr := os.ReadFile("/etc/localtime")
+	data, err := os.ReadFile("/etc/TZ")
+	if nil != timeZoneErr && err == nil {
+		// 不存在 zonezoneinfo 包 且 存在 /etc/TZ 文件
+		// 转成字符串
+		content := string(data)
+
+		if content == "" {
+			// 空内容
+			return
+		}
+
+		// 正则
+		re := regexp.MustCompile(`^(?P<STD>[A-Z]+)(?P<arithmetic>[-+]?)(?P<offset>[0-9]{0,1})`)
+
+		// 正则匹配
+		matches := re.FindAllStringSubmatch(content, -1)
+
+		// 分组名称
+		groupNames := re.SubexpNames()
+
+		var result []map[string]string
+		for _, match := range matches {
+			m := make(map[string]string)
+			for i, name := range groupNames {
+				if i != 0 && name != "" {
+					m[name] = strings.TrimSpace(match[i])
+				}
+			}
+			result = append(result, m)
+		}
+
+		if len(result) < 1 {
+			// 匹配失败
+			return
+		}
+
+		// 只取 第一个
+		data := result[0]
+
+		// jsonResult, _ := json.MarshalIndent(data, "", " ")
+		// fmt.Println(string(jsonResult))
+
+		std, isOk := data["STD"]
+		if !isOk {
+			// 获取 失败
+			return
+		}
+
+		arithmetic := 1
+		if value, isOk := data["arithmetic"]; isOk {
+			// 获取 成功
+			if value == "+" {
+				// 负数
+				arithmetic = -1
+			}
+		}
+
+		offset := 0
+		if offsetStr, isOk := data["offset"]; isOk {
+			// 获取 成功
+			if offsetStr != "" {
+				// 不为空
+				tempOffset, err := strconv.Atoi(offsetStr)
+				if err != nil {
+					// 转换失败
+					return
+				} else {
+					// 转换成功
+					offset = tempOffset
+				}
+			}
+		}
+
+		// 设置时区
+		time.Local = time.FixedZone(std, arithmetic*offset*60*60)
+	}
+}
+
 func main() {
+	// 解决 openwrt 时区问题
+	fixedTimeZone()
+
 	os.Args = getArgsV4Compatible()
 
 	base.RootCommand.Long = "Xray is a platform for building proxies."
